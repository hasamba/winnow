# Copy to .env and fill in what you need. .env is gitignored — it never leaves this machine.
# A real environment variable overrides anything set here.

# Narrating with --narrator claude-api
ANTHROPIC_API_KEY=

# Narrating with --narrator openrouter.
# Leave blank to fall back to ~/.config/typesafe/openrouter.env, which is where the Jev key
# already lives. Jev itself always reads that file and is never configured here.
OPENROUTER_API_KEY=

# Optional defaults, so you do not retype them on every run.
# WINNOW_NARRATOR=claude-api
# WINNOW_MODEL=claude-sonnet-4-5
# WINNOW_WORKERS=16
