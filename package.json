{
  "name": "winnow",
  "version": "0.1.0",
  "description": "Separate the grain from the chaff in a Plaso supertimeline: grade every row with a decision model, then narrate what survives.",
  "type": "module",
  "bin": {
    "winnow": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "winnow": "tsx src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
